          </div>\n          <div className=\"content-stretch flex flex-col gap-[var(--v2-space-1,4px)] items-start relative shrink-0 w-full\" data-node-id=\"62:2507\" data-name=\"Tools\">\n            <p className=\"[word-break:break-word] font-['Outfit:Regular'] font-normal leading-[16px] relative shrink-0 text-[12px] text-[color:var(--v2-color-text-muted,#a2ada6)] text-center w-[48px]\" data-node-id=\"62:2508\">\n              Tools\n            </p>\n            <a className=\"content-stretch cursor-pointer flex gap-[var(--v2-space-3,12px)] h-[48px] items-center overflow-clip px-[14px] py-[var(--v2-space-3,12px)] relative rounded-[var(--v2-radius-control,12px)] shrink-0 w-[206px]\" data-node-id=\"62:2509\" data-name=\"Navigate / Compare playlists\">\n              <div className=\"relative shrink-0 size-[20px]\" data-node-id=\"I62:2509;62:2394\" data-name=\"Analytify/Icon / list\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgAnalytifyIconClone} />\n              </div>\n              <p className=\"[word-break:break-word] flex-[1_0_0] font-['Outfit:SemiBold'] font-semibold leading-[20px] min-w-px relative text-[14px] text-[color:var(--v2-color-text,#f5f7f5)] text-left\" data-node-id=\"I62:2509;62:2401\">\n                Compare playlists\n              </p>\n            </a>\n          </div>\n          {showAdministration && (\n            <div className=\"content-stretch flex flex-col gap-[var(--v2-space-1,4px)] items-start relative shrink-0 w-full\" data-node-id=\"62:2591\" data-name=\"Administrator access\">\n              <p className=\"[word-break:break-word] font-['Outfit:Regular'] font-normal h-[20px] leading-[20px] relative shrink-0 text-[14px] text-[color:var(--v2-color-text-muted,#a2ada6)] w-[66px]\" data-node-id=\"62:2592\">\n                Administrator only\n              </p>\n              <a className=\"content-stretch cursor-pointer flex gap-[var(--v2-space-3,12px)] h-[48px] items-center ove