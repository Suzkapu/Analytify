{
  "name": "spoti-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "architecture:check": "node scripts/check-architecture.mjs",
    "retention:check": "node scripts/check-playlist-share-retention.mjs",
    "share-refresh:check": "node scripts/check-playlist-share-refresh.mjs",
    "song-league-invites:check": "node scripts/check-song-league-invites.mjs",
    "song-league-rules:check": "node scripts/check-song-league-rules.mjs",
    "song-league-notifications:check": "node --test supabase/functions/song-league-notifications/delivery-state.test.mjs && node scripts/check-song-league-notifications.mjs",
    "stats-calendars:check": "node scripts/check-stats-calendars.mjs",
    "stats-sharing:check": "node scripts/check-stats-sharing.mjs",
    "stats-history-search:check": "node scripts/check-stats-history-search.mjs",
    "loading-feedback:check": "node scripts/check-loading-feedback.mjs",
    "performance:check": "node scripts/check-performance-contracts.mjs",
    "api-usage:check": "node scripts/check-api-on-demand.mjs",
    "admin:check": "node scripts/check-admin-control-plane.mjs",
    "deployment-pipeline:check": "node scripts/check-deployment-pipeline.mjs",
    "sync-service:check": "node --test services/sync-service/spotify-url-validator.test.js services/sync-service/date-utils.test.js services/sync-service/task-registry.test.js services/sync-service/scheduler.test.js services/sync-service/credential-store.test.js services/sync-service/spotify-client.test.js services/sync-service/push-dispatcher.test.js services/sync-service/tasks/history-task.test.js services/sync-service/tasks/stats-task.test.js services/sync-service/tasks/shared-playlists-task.test.js",
    "edge-functions:check": "deno check --config supabase/functions/deno.json supabase/functions/spotify-credentials/index.ts supabase/functions/song-league-playlist-sync/index.ts supabase/functions/song-league-notifications/index.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.spec.json --noEmit",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage --progress=false",
    "test:supabase-integration": "ng test --watch=false --browsers=ChromeHeadless --karma-config karma.supabase-integration.conf.cjs --include=src/app/integration/supabase-loading.integration.spec.ts --progress=false",
    "sync:once": "node services/sync-service/index.js",
    "sync:watch": "node services/sync-service/index.js --watch",
    "verify": "npm run architecture:check && npm run retention:check && npm run share-refresh:check && npm run song-league-invites:check && npm run song-league-rules:check && npm run song-league-notifications:check && npm run stats-calendars:check && npm run stats-sharing:check && npm run stats-history-search:check && npm run loading-feedback:check && npm run performance:check && npm run api-usage:check && npm run admin:check && npm run deployment-pipeline:check && npm run sync-service:check && npm run edge-functions:check && npm run typecheck && npm run typecheck:tests && npm run build:production",
    "verify:ci": "npm run architecture:check && npm run retention:check && npm run share-refresh:check && npm run song-league-invites:check && npm run song-league-rules:check && npm run song-league-notifications:check && npm run stats-calendars:check && npm run stats-sharing:check && npm run stats-history-search:check && npm run loading-feedback:check && npm run performance:check && npm run api-usage:check && npm run admin:check && npm run deployment-pipeline:check && npm run sync-service:check && npm run edge-functions:check && npm run typecheck && npm run typecheck:tests && npm run test:ci && npm run build:production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@angular/service-worker": "^16.2.0",
    "@supabase/supabase-js": "^2.108.1",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primeng": "^16.8.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.3",
    "@angular/cli": "~16.2.3",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.130",
    "@types/qrcode": "^1.5.5",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3"
  }
}
